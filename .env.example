APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://attendance:attendance@localhost:5432/attendance?sslmode=disable
ALLOWED_ORIGIN=http://localhost:5173
LOG_LEVEL=debug
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
DEVICE_OFFLINE_SECONDS=60
JWT_SECRET=replace-with-at-least-32-random-bytes
CODE_HMAC_SECRET=replace-with-at-least-32-random-bytes
MAIL_API_KEY=
MAIL_FROM=Campus Attendance <noreply@example.test>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Seed venues default to placeholder coordinates and print a warning.
# In Google Maps, right-click your location and copy coordinates (latitude first).
SEED_ORIGIN_LAT=
SEED_ORIGIN_LNG=
# Venue radius in metres; indoor browser location can be imprecise.
SEED_VENUE_RADIUS_M=150
